    PROJECTS {
        uuid id PK
        varchar slug UK
        varchar provider
        varchar repo_full_name
        varchar default_branch
        text webhook_secret_enc
        jsonb settings
        timestamptz last_run_at
    }

    WEBHOOK_DELIVERIES {
        bigint id PK
        uuid project_id FK
        varchar delivery_id
        varchar event_type
        varchar after_sha
        varchar dedupe_key UK
        varchar status
        jsonb payload
    }

    ANALYSIS_RUNS {
        uuid id PK
        uuid project_id FK
        varchar trigger_type
        varchar base_sha
        varchar head_sha
        varchar status
        int tokens_in
        int tokens_out
        int entities_changed
    }

    CODE_ENTITIES {
        bigint id PK
        uuid project_id FK
        varchar file_path
        varchar qualified_name
        varchar entity_type
        varchar source_hash
        int start_line
        int end_line
    }

    DOCUMENTS {
        uuid id PK
        uuid project_id FK
        varchar doc_type
        varchar target_key
        varchar content_format
        varchar status
        boolean manual_edited
        bigint current_revision_id FK
    }

    DOCUMENT_REVISIONS {
        bigint id PK
        uuid document_id FK
        int version
        text content
        boolean render_ok
        varchar created_by
    }

    AI_INVOCATIONS {
        bigint id PK
        uuid run_id FK
        varchar provider
        varchar model
        varchar prompt_hash
        int prompt_tokens
        int completion_tokens
        int latency_ms
        varchar status
    }
